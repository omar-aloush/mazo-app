{
  "expo": {
    "name": "Mazō",
    "slug": "mazo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mazo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14201a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mazo.ai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#14201a"
      },
      "package": "app.mazo.ai",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#14201a"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mazo.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8FB896",
          "sounds": []
        }
      ],
      "expo-localization",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Mazō to access your microphone to voice chat directly with the coach."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Mazō adds focus blocks and plans to your calendar — only the ones you approve.",
          "remindersPermission": "Mazō adds reminders you approve."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Mazō uses your contacts so you can say “text Omar” or “call Mom” and it finds the right person."
        }
      ],
      "./plugins/withMazoWidget.js",
      "./plugins/withIosPodMinimum.js",
      "./plugins/withIosSceneCompat.js",
      "./plugins/withAndroidQueries.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://mazo.app/"
      },
      "eas": {
        "projectId": "0e85eb81-4a8e-4a8a-b632-2d2a6e861018"
      }
    }
  }
}
