# Environment Variables

# Public Supabase client configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# RevenueCat Configuration - Required for Shipathon 2026
# Get your keys & project ID from https://app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_PROJECT_ID=your_revenuecat_project_id_here
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=your_test_api_key_here
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_api_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# OPENAI_API_KEY is server-only. Store it with Supabase Edge Function secrets;
# never prefix it with EXPO_PUBLIC_ or include it in a client build.
