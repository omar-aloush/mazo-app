!modules/**/android/**
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.*
!.env.example

# typescript
*.tsbuildinfo
.vercel

.rork

.env
rork-eslint.config.js

